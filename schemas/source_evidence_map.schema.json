{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forsy.ai/schemas/agent-apprenticeship/source_evidence_map.schema.json",
  "title": "Source Evidence Map",
  "type": "object",
  "required": ["evidence_ref", "source_type", "evidence_kind", "visibility", "confidence"],
  "properties": {
    "evidence_ref": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": ["trace", "trace_step", "artifact", "actual_output", "review_packet", "verifier_record", "grader_record", "repair_record", "manifest", "generated_row"]
    },
    "evidence_kind": { "type": "string", "minLength": 1 },
    "visibility": { "type": "string", "enum": ["visible", "inferred", "generated"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source_id": { "type": "string" },
    "source_path": { "type": "string" },
    "source_content_hash": { "type": "string" },
    "row_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
